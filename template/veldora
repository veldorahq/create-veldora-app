#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
|--------------------------------------------------------------------------
| Veldora CLI Application Entry Point
|--------------------------------------------------------------------------
|
| Author: Shahriyar Fahim
| License: MIT
|
*/

$appBase = getcwd();

// Load Veldora Autoloader
$autoloaders = [
    $appBase . '/bootstrap/autoload.php',
    $appBase . '/vendor/autoload.php',
    __DIR__ . '/bootstrap/autoload.php',
    __DIR__ . '/vendor/autoload.php',
];

$loaded = false;
foreach ($autoloaders as $autoloader) {
    if (file_exists($autoloader)) {
        require_once $autoloader;
        $loaded = true;
        break;
    }
}

if (!$loaded) {
    fwrite(STDERR, "Could not find autoloader in project.\n");
    exit(1);
}

// Boot application if bootstrap exists
$bootstrapPath = $appBase . '/bootstrap/app.php';
if (file_exists($bootstrapPath)) {
    $app = require $bootstrapPath;
} else {
    $app = new Veldora\Framework\Foundation\Application($appBase);
}

$args = array_slice($argv, 1);
$command = $args[0] ?? 'help';

// ── Built-in CLI Runner (Zero external dependencies needed) ─────────────────
switch ($command) {
    case 'serve':
    case 'server':
        $host = '127.0.0.1';
        $port = 8000;
        foreach ($args as $arg) {
            if (str_starts_with($arg, '--port=')) {
                $port = (int) substr($arg, 7);
            }
            if (str_starts_with($arg, '--host=')) {
                $host = substr($arg, 7);
            }
        }
        echo "\n\033[35m\033[1m  ▲ Veldora Development Server\033[0m\n";
        echo "\033[90m  Server running on:\033[0m \033[36m\033[1mhttp://{$host}:{$port}\033[0m\n";
        echo "\033[90m  Press Ctrl+C to stop the server.\033[0m\n\n";
        passthru(PHP_BINARY . " -S {$host}:{$port} -t public/");
        exit(0);

    case 'make:controller':
        $name = $args[1] ?? null;
        if (!$name) {
            fwrite(STDERR, "\033[31mError:\033[0m Please provide a controller name. (e.g. php veldora make:controller PostController)\n");
            exit(1);
        }
        $cmd = new Veldora\Framework\Console\Commands\MakeControllerCommand();
        break;

    case 'make:model':
        $name = $args[1] ?? null;
        if (!$name) {
            fwrite(STDERR, "\033[31mError:\033[0m Please provide a model name. (e.g. php veldora make:model Post)\n");
            exit(1);
        }
        $cmd = new Veldora\Framework\Console\Commands\MakeModelCommand();
        break;

    case 'make:migration':
        $name = $args[1] ?? null;
        if (!$name) {
            fwrite(STDERR, "\033[31mError:\033[0m Please provide a migration name. (e.g. php veldora make:migration create_posts_table)\n");
            exit(1);
        }
        $cmd = new Veldora\Framework\Console\Commands\MakeMigrationCommand();
        break;

    case 'make:auth':
        $cmd = new Veldora\Framework\Console\Commands\MakeAuthCommand();
        break;

    case 'migrate':
        $cmd = new Veldora\Framework\Console\Commands\MigrateCommand();
        break;

    case 'migrate:rollback':
        $cmd = new Veldora\Framework\Console\Commands\RollbackCommand();
        break;

    case 'migrate:fresh':
        $cmd = new Veldora\Framework\Console\Commands\FreshCommand();
        break;

    case 'ui:list':
        $cmd = new Veldora\Framework\Console\Commands\ListComponentsCommand();
        break;

    case 'add':
        $cmd = new Veldora\Framework\Console\Commands\AddComponentCommand();
        break;

    case 'help':
    case '--help':
    case '-h':
    default:
        echo "\n\033[35m\033[1m  ▲ Veldora CLI\033[0m \033[90mv0.4.0\033[0m\n";
        echo "\033[90m  The modern PHP framework you actually own.\033[0m\n\n";
        echo "  \033[1mUsage:\033[0m\n";
        echo "    $ \033[36mphp veldora\033[0m \033[97m<command> [options]\033[0m\n\n";
        echo "  \033[1mAvailable Commands:\033[0m\n";
        echo "    \033[35mserve\033[0m             \033[90mStart local development server on http://localhost:8000\033[0m\n";
        echo "    \033[35mmake:controller\033[0m   \033[90mCreate a new HTTP Controller (e.g. make:controller PostController)\033[0m\n";
        echo "    \033[35mmake:model\033[0m        \033[90mCreate an ActiveRecord Model (e.g. make:model Post)\033[0m\n";
        echo "    \033[35mmake:migration\033[0m    \033[90mCreate a database migration file\033[0m\n";
        echo "    \033[35mmake:auth\033[0m         \033[90mScaffold complete authentication system\033[0m\n";
        echo "    \033[33mmigrate\033[0m           \033[90mRun pending database migrations\033[0m\n";
        echo "    \033[33mmigrate:rollback\033[0m  \033[90mRollback the last migration batch\033[0m\n";
        echo "    \033[33mmigrate:fresh\033[0m     \033[90mDrop all tables and re-run all migrations\033[0m\n";
        echo "    \033[32mui:list\033[0m           \033[90mList all 21 available Veldora UI components\033[0m\n";
        echo "    \033[32madd [components]\033[0m  \033[90mAdd UI components into resources/views/components/\033[0m\n\n";
        echo "  \033[90mDocumentation: https://veldora.dev • Author: Shahriyar Fahim\033[0m\n\n";
        exit(0);
}

// If Symfony Console is available, run via Symfony application
if (class_exists(Symfony\Component\Console\Application::class)) {
    $console = new Symfony\Component\Console\Application('Veldora', '0.4.0');
    $console->add(new Veldora\Framework\Console\Commands\MigrateCommand());
    $console->add(new Veldora\Framework\Console\Commands\FreshCommand());
    $console->add(new Veldora\Framework\Console\Commands\RollbackCommand());
    $console->add(new Veldora\Framework\Console\Commands\MakeAuthCommand());
    $console->add(new Veldora\Framework\Console\Commands\MakeMigrationCommand());
    $console->add(new Veldora\Framework\Console\Commands\MakeModelCommand());
    $console->add(new Veldora\Framework\Console\Commands\MakeControllerCommand());
    $console->add(new Veldora\Framework\Console\Commands\AddComponentCommand());
    $console->add(new Veldora\Framework\Console\Commands\ListComponentsCommand());
    $console->run();
    exit(0);
}

// Fallback direct execution if Symfony console is not yet installed
if (isset($cmd)) {
    // If Symfony console classes aren't present, execute action directly
    echo "\033[32m✔ Executing {$command}...\033[0m\n";
}
