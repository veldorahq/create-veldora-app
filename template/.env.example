#
# Veldora Environment Configuration
# ----------------------------------
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and will be ignored.
# Supported types: strings, numbers, true/false, null
# Variable interpolation: APP_URL = http://${APP_HOST}
#

# ----------------------------------
# App
# ----------------------------------

APP_NAME  = Veldora
APP_ENV   = local
APP_DEBUG = true
APP_KEY   = "change-this-to-a-random-secret"
APP_URL   = http://localhost:8000

# ----------------------------------
# Database
# ----------------------------------

DB_CONNECTION = sqlite
DB_DATABASE   = ./database/veldora.sqlite

# Uncomment below for MySQL:
# DB_CONNECTION = mysql
# DB_HOST       = 127.0.0.1
# DB_PORT       = 3306
# DB_DATABASE   = veldora
# DB_USERNAME   = root
# DB_PASSWORD   = ""

# ----------------------------------
# Session
# ----------------------------------

SESSION_DRIVER   = file
SESSION_LIFETIME = 120

# ----------------------------------
# Mail
# ----------------------------------

MAIL_HOST       = smtp.mailtrap.io
MAIL_PORT       = 587
MAIL_USERNAME   = null
MAIL_PASSWORD   = null
MAIL_ENCRYPTION = tls
MAIL_FROM_NAME  = ${APP_NAME}

# ----------------------------------
# Cache
# ----------------------------------

CACHE_DRIVER = file
